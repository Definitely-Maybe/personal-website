---
import EmptyState from '../../components/EmptyState.astro';
import Pagination from '../../components/Pagination.astro';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getEssays } from '../../lib/content';

export const prerender = false;

const essays = (await getEssays()).sort((a, b) => b.date.valueOf() - a.date.valueOf());
const years = [...new Set(essays.map((essay) => String(essay.date.getFullYear())))];
const tags = [...new Set(essays.flatMap((essay) => essay.tags))];
---

<ContentLayout title="随笔" eyebrow="Essays" description="生活里一些没有被整理成结论的片段，先放在这里。">
  <div class="essay-index">
    <div class="essay-results">
      <div class="entry-list" data-essay-list>
        {essays.map((essay) => (
          <a class="entry-card" href={`/essays/${essay.slug}`} data-year={essay.date.getFullYear()} data-tags={essay.tags.join(',')} data-page-item>
            <time datetime={essay.date.toISOString()}>{essay.date.toLocaleDateString('zh-CN')}</time>
            <div>
              <h2>{essay.title}</h2>
              <p>{essay.summary}</p>
              <div class="tag-row">
                {essay.mood && <span>{essay.mood}</span>}
                {essay.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
          </a>
        ))}
        <EmptyState title="这里还没有公开的随笔。" hidden={essays.length > 0} />
        <EmptyState title="没有符合这个筛选的随笔。" hidden data-empty-filter />
      </div>
      <Pagination label="随笔分页" pageSize={6} />
    </div>

    <aside class="essay-filter" aria-label="随笔筛选">
      <section>
        <h2>时间</h2>
        <div class="filter-row">
          <button type="button" class="filter-chip is-active" data-filter-year="all">全部</button>
          {years.map((year) => <button type="button" class="filter-chip" data-filter-year={year}>{year}</button>)}
        </div>
      </section>

      <section>
        <h2>标签</h2>
        <div class="filter-row">
          <button type="button" class="filter-chip is-active" data-filter-tag="all">全部</button>
          {tags.map((tag) => <button type="button" class="filter-chip" data-filter-tag={tag}>{tag}</button>)}
        </div>
      </section>
    </aside>
  </div>
</ContentLayout>

<script>
  const yearButtons = document.querySelectorAll('[data-filter-year]');
  const tagButtons = document.querySelectorAll('[data-filter-tag]');
  const entries = Array.from(document.querySelectorAll<HTMLElement>('[data-year][data-tags][data-page-item]'));
  const pagination = document.querySelector<HTMLElement>('[data-pagination]');
  const emptyFilter = document.querySelector<HTMLElement>('[data-empty-filter]');
  const pageSize = Number(pagination?.dataset.pageSize ?? 6);
  const first = pagination?.querySelector<HTMLButtonElement>('[data-page-first]');
  const prev = pagination?.querySelector<HTMLButtonElement>('[data-page-prev]');
  const next = pagination?.querySelector<HTMLButtonElement>('[data-page-next]');
  const last = pagination?.querySelector<HTMLButtonElement>('[data-page-last]');
  const status = pagination?.querySelector<HTMLElement>('[data-page-status]');
  const pageNumbers = pagination?.querySelector<HTMLElement>('[data-page-numbers]');
  let selectedYear = 'all';
  let selectedTag = 'all';
  let page = 1;

  function updateActive(buttons: NodeListOf<Element>, selectedValue: string, attribute: string) {
    buttons.forEach((button) => {
      button.classList.toggle('is-active', button.getAttribute(attribute) === selectedValue);
    });
  }

  function renderPageButtons(pageCount: number) {
    if (!pageNumbers) return;
    pageNumbers.innerHTML = '';
    for (let pageNumber = 1; pageNumber <= pageCount; pageNumber += 1) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'pagination__page';
      button.textContent = String(pageNumber);
      button.setAttribute('aria-label', `第 ${pageNumber} 页`);
      if (pageNumber === page) {
        button.setAttribute('aria-current', 'page');
      }
      button.addEventListener('click', () => {
        page = pageNumber;
        render();
      });
      pageNumbers.append(button);
    }
  }

  function getFilteredEntries() {
    return entries.filter((entry) => {
      const yearMatches = selectedYear === 'all' || entry.getAttribute('data-year') === selectedYear;
      const tagList = (entry.getAttribute('data-tags') ?? '').split(',');
      const tagMatches = selectedTag === 'all' || tagList.includes(selectedTag);
      return yearMatches && tagMatches;
    });
  }

  function render() {
    const filteredEntries = getFilteredEntries();
    const pageCount = Math.max(1, Math.ceil(filteredEntries.length / pageSize));
    page = Math.min(page, pageCount);
    renderPageButtons(pageCount);

    entries.forEach((entry) => entry.toggleAttribute('hidden', true));
    filteredEntries.forEach((entry, index) => {
      const visible = index >= (page - 1) * pageSize && index < page * pageSize;
      entry.toggleAttribute('hidden', !visible);
    });

    if (emptyFilter) emptyFilter.hidden = filteredEntries.length > 0;
    if (pagination) pagination.hidden = filteredEntries.length <= pageSize;
    if (status) status.textContent = `第 ${page} / ${pageCount} 页`;
    if (first) first.disabled = page <= 1;
    if (prev) prev.disabled = page <= 1;
    if (next) next.disabled = page >= pageCount;
    if (last) last.disabled = page >= pageCount;

    updateActive(yearButtons, selectedYear, 'data-filter-year');
    updateActive(tagButtons, selectedTag, 'data-filter-tag');
  }

  yearButtons.forEach((button) => {
    button.addEventListener('click', () => {
      selectedYear = button.getAttribute('data-filter-year') ?? 'all';
      page = 1;
      render();
    });
  });

  tagButtons.forEach((button) => {
    button.addEventListener('click', () => {
      selectedTag = button.getAttribute('data-filter-tag') ?? 'all';
      page = 1;
      render();
    });
  });

  first?.addEventListener('click', () => {
    page = 1;
    render();
  });

  prev?.addEventListener('click', () => {
    page -= 1;
    render();
  });

  next?.addEventListener('click', () => {
    page += 1;
    render();
  });

  last?.addEventListener('click', () => {
    page = Math.max(1, Math.ceil(getFilteredEntries().length / pageSize));
    render();
  });

  render();
</script>
