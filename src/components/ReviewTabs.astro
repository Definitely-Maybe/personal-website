---
import EmptyState from './EmptyState.astro';
import Pagination from './Pagination.astro';
import RatingStars from './RatingStars.astro';
import type { Review } from '../lib/content/types';
import { formatReviewDate, formatReviewRating, getReviewCover, hasLongReview } from '../lib/reviews/display';

interface Props {
  reviews: Review[];
}

const { reviews } = Astro.props;
const categories = [
  { key: 'music', label: '音乐' },
  { key: 'book', label: '书籍' },
  { key: 'film', label: '影视' },
] as const;
---

<div class="review-tabs">
  <div class="review-tabs__controls" role="tablist" aria-label="书影音分类">
    {categories.map((category, index) => (
      <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-review-tab={category.key}>
        {category.label}
      </button>
    ))}
  </div>

  {categories.map((category, index) => {
    const categoryReviews = reviews.filter((review) => review.category === category.key);

    return (
      <section class="review-panel-wrap" data-review-panel={category.key} hidden={index !== 0}>
        <div class="review-panel" data-paginated-list>
          {categoryReviews.map((review) => {
            const cover = getReviewCover(review);
            const longReview = hasLongReview(review);

            return (
              <a class="review-card" href={`/reviews/${review.slug}`} data-page-item aria-label={`${review.title} 详情`}>
                <img class="review-card__cover" src={cover.src} alt={cover.alt} loading="lazy" />
                <div class="review-card__body">
                  <p class="review-card__meta">{review.creator} · {review.year}</p>
                  <p class="review-card__date">{formatReviewDate(review.date)}</p>
                  <h2>{review.title}</h2>
                  <p>{review.summary}</p>
                  <div class="review-card__rating">
                    <strong>{formatReviewRating(review.rating)}</strong>
                    <RatingStars rating={review.rating} />
                  </div>
                  <div class="tag-row">
                    {longReview && <span>长评</span>}
                    {review.tags.map((tag) => <span>{tag}</span>)}
                    {review.moments.map((moment) => <span>{moment}</span>)}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
        <EmptyState title="这个分类暂时是空的，之后再慢慢补上。" hidden={categoryReviews.length > 0} />
        <Pagination label={`${category.label}分页`} pageSize={6} />
      </section>
    );
  })}
</div>

<script>
  const tabs = document.querySelectorAll<HTMLElement>('[data-review-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-review-panel]');

  function setupPagination(panel: HTMLElement) {
    const list = panel.querySelector<HTMLElement>('[data-paginated-list]');
    const pagination = panel.querySelector<HTMLElement>('[data-pagination]');
    if (!list || !pagination) return;

    const paginationNav = pagination;
    const items = Array.from(list.querySelectorAll<HTMLElement>('[data-page-item]'));
    const pageSize = Number(paginationNav.dataset.pageSize ?? 6);
    const first = paginationNav.querySelector<HTMLButtonElement>('[data-page-first]');
    const prev = paginationNav.querySelector<HTMLButtonElement>('[data-page-prev]');
    const next = paginationNav.querySelector<HTMLButtonElement>('[data-page-next]');
    const last = paginationNav.querySelector<HTMLButtonElement>('[data-page-last]');
    const status = paginationNav.querySelector<HTMLElement>('[data-page-status]');
    const pageNumbers = paginationNav.querySelector<HTMLElement>('[data-page-numbers]');
    let page = 1;

    function renderPageButtons(pageCount: number) {
      if (!pageNumbers) return;
      pageNumbers.innerHTML = '';
      for (let pageNumber = 1; pageNumber <= pageCount; pageNumber += 1) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'pagination__page';
        button.textContent = String(pageNumber);
        button.setAttribute('aria-label', `第 ${pageNumber} 页`);
        if (pageNumber === page) {
          button.setAttribute('aria-current', 'page');
        }
        button.addEventListener('click', () => {
          page = pageNumber;
          render();
        });
        pageNumbers.append(button);
      }
    }

    function render() {
      const pageCount = Math.max(1, Math.ceil(items.length / pageSize));
      page = Math.min(page, pageCount);
      renderPageButtons(pageCount);
      items.forEach((item, index) => {
        const visible = index >= (page - 1) * pageSize && index < page * pageSize;
        item.toggleAttribute('hidden', !visible);
      });
      paginationNav.hidden = items.length <= pageSize;
      if (status) status.textContent = `第 ${page} / ${pageCount} 页`;
      if (first) first.disabled = page <= 1;
      if (prev) prev.disabled = page <= 1;
      if (next) next.disabled = page >= pageCount;
      if (last) last.disabled = page >= pageCount;
    }

    first?.addEventListener('click', () => {
      page = 1;
      render();
    });

    prev?.addEventListener('click', () => {
      page -= 1;
      render();
    });

    next?.addEventListener('click', () => {
      page += 1;
      render();
    });

    last?.addEventListener('click', () => {
      page = Math.max(1, Math.ceil(items.length / pageSize));
      render();
    });

    panel.addEventListener('reset-pagination', () => {
      page = 1;
      render();
    });

    render();
  }

  panels.forEach(setupPagination);

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const selected = tab.getAttribute('data-review-tab');
      tabs.forEach((item) => item.setAttribute('aria-selected', String(item === tab)));
      panels.forEach((panel) => {
        panel.toggleAttribute('hidden', panel.getAttribute('data-review-panel') !== selected);
        if (panel.getAttribute('data-review-panel') === selected) {
          panel.dispatchEvent(new CustomEvent('reset-pagination'));
        }
      });
    });
  });
</script>
