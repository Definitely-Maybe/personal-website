---
interface Props {
  label: string;
  pageSize: number;
}

const { label, pageSize } = Astro.props;
---

<nav class="pagination" aria-label={label} data-pagination data-page-size={pageSize} hidden>
  <button type="button" data-page-prev aria-label="上一页">上一页</button>
  <span data-page-status>第 1 页</span>
  <button type="button" data-page-next aria-label="下一页">下一页</button>
</nav>
