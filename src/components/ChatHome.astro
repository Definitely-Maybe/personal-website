---
import { suggestedPrompts } from '../data/chatPresets';
---

<section class="chat-home" data-chat-home>
  <div class="chat-home__intro" data-chat-intro>
    <p class="chat-home__date">2026 · 私人对话入口</p>
    <h1>我们从哪里开始呢？</h1>
  </div>

  <div class="chat-thread" data-chat-thread aria-live="polite"></div>

  <div class="chat-home__composer">
    <form class="chat-box" data-chat-form>
      <span class="chat-box__plus" aria-hidden="true">+</span>
      <label class="sr-only" for="chat-input">输入问题</label>
      <input id="chat-input" name="message" placeholder="问我一首歌、一篇随笔，或者一个适合今天的问题" autocomplete="off" data-chat-input />
      <button type="submit">发送</button>
    </form>
    <div class="prompt-row" aria-label="建议问题">
      {suggestedPrompts.map((prompt) => (
        <button type="button" data-prompt={prompt}>{prompt}</button>
      ))}
    </div>
  </div>
</section>

<script>
  import { CHAT_STORAGE_KEY, truncateMessages } from '../lib/chat/session';
  import type { ChatMessage } from '../lib/chat/types';
  import { getSimulatedReply } from '../data/chatPresets';

  const home = document.querySelector('[data-chat-home]');
  const form = document.querySelector('[data-chat-form]');
  const input = document.querySelector('[data-chat-input]');
  const thread = document.querySelector('[data-chat-thread]');
  const promptButtons = document.querySelectorAll('[data-prompt]');

  function addMessage(role: 'user' | 'assistant', text: string) {
    const message = document.createElement('div');
    message.className = `chat-message chat-message--${role}`;
    message.textContent = text;
    thread?.append(message);
    message.scrollIntoView({ block: 'end', behavior: 'smooth' });
    return message;
  }

  function loadMessages(): ChatMessage[] {
    try {
      const raw = sessionStorage.getItem(CHAT_STORAGE_KEY);
      if (!raw) return [];
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function saveMessages(messages: ChatMessage[]) {
    sessionStorage.setItem(CHAT_STORAGE_KEY, JSON.stringify(truncateMessages(messages)));
  }

  function renderMessages(messages: ChatMessage[]) {
    if (!thread) return;
    thread.innerHTML = '';
    for (const msg of messages) {
      addMessage(msg.role, msg.content);
    }
  }

  async function streamReply(messages: ChatMessage[], target: HTMLElement) {
    const response = await fetch('/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ messages }),
    });

    if (!response.ok) {
      if (import.meta.env.DEV && response.status === 503) {
        target.textContent = getSimulatedReply(messages.at(-1)?.content ?? '');
        return;
      }
      target.textContent = '暂时无法回答，请稍后再试。';
      return;
    }

    const reader = response.body?.getReader();
    const decoder = new TextDecoder();
    let buffer = '';
    target.textContent = '';
    target.classList.add('chat-message--typing');

    while (reader) {
      const { done, value } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      const parts = buffer.split('\n\n');
      buffer = parts.pop() ?? '';
      for (const part of parts) {
        const line = part.split('\n').find((l) => l.startsWith('data: '));
        if (!line) continue;
        const data = line.slice(6).trim();
        if (data === '[DONE]') break;
        try {
          const json = JSON.parse(data) as { content?: string; error?: string };
          if (json.error) {
            target.textContent = json.error;
            return;
          }
          if (json.content) {
            target.classList.remove('chat-message--typing');
            target.textContent += json.content;
          }
        } catch {
          /* ignore malformed SSE chunks */
        }
      }
    }
  }

  async function submitMessage(text: string) {
    const value = text.trim();
    if (!value) return;

    home?.classList.add('chat-home--active');

    const messages = loadMessages();
    messages.push({ role: 'user', content: value });
    addMessage('user', value);

    const pending = addMessage('assistant', '正在整理一小段回答');
    pending.classList.add('chat-message--typing');

    await streamReply(messages, pending);
    pending.classList.remove('chat-message--typing');

    const assistantText = pending.textContent ?? '';
    if (assistantText && assistantText !== '正在整理一小段回答') {
      messages.push({ role: 'assistant', content: assistantText });
    }
    saveMessages(messages);
  }

  const restored = loadMessages();
  if (restored.length > 0) {
    home?.classList.add('chat-home--active');
    renderMessages(restored);
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const value = input instanceof HTMLInputElement ? input.value : '';
    submitMessage(value);
    if (input instanceof HTMLInputElement) input.value = '';
  });

  promptButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const prompt = button.getAttribute('data-prompt') ?? '';
      submitMessage(prompt);
    });
  });

  const promptFromUrl = new URLSearchParams(window.location.search).get('prompt');
  if (promptFromUrl) {
    window.setTimeout(() => submitMessage(promptFromUrl), 160);
  }
</script>
