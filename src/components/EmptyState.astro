---
interface Props {
  title: string;
  description?: string;
  hidden?: boolean;
  [key: string]: unknown;
}

const { title, description, hidden = false, ...attrs } = Astro.props;
---

<div class="empty-state" hidden={hidden} {...attrs}>
  <p>{title}</p>
  {description && <span>{description}</span>}
</div>
