---
import AppLayout from './AppLayout.astro';

interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
}

const { title, eyebrow, description } = Astro.props;
const hasControls = Astro.slots.has('controls');
---

<AppLayout title={`${title} - 未命名的小站`}>
  <section class="content-page">
    <div class="content-page__sticky">
      <header class="page-head">
        <div>
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <h1>{title}</h1>
        </div>
        {description && <p class="page-description">{description}</p>}
      </header>
      {hasControls && (
        <div class="page-controls">
          <slot name="controls" />
        </div>
      )}
    </div>
    <slot />
  </section>
</AppLayout>
