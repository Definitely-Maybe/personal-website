---
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = '未命名的小站' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="一个私人化的中文个人网站，存放随笔、书影音、时间线和对话入口。" />
    <title>{title}</title>
  </head>
  <body>
    <div class="app-shell">
      <Sidebar />
      <main class="app-main">
        <slot />
      </main>
    </div>
  </body>
</html>
